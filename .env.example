# Concrete companion to the typed env schema in src/env.ts — every variable the
# service reads, with safe local-dev values. Copy to .env for local runs.

NODE_ENV=development
# APP_ENV gates /docs (mounted in development/test/staging, absent in production)
APP_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Auth stub: bearer token required by protected routes (replace with real authN)
API_TOKEN=local-dev-token-change-me

# Seeded edge limits (concrete defaults; /health is exempt from rate limiting)
RATE_LIMIT_MAX_PER_MINUTE=300
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000

# OpenTelemetry (always on outside test; exports via OTLP/HTTP)
OTEL_SERVICE_NAME=cube
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
